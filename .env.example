# CMCart Environment Configuration

# Firebase Authentication
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=cmcart-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cmcart-store
VITE_FIREBASE_STORAGE_BUCKET=cmcart-store.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Supabase PostgreSQL Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary Media CDN
VITE_CLOUDINARY_CLOUD_NAME=cmcart-media
VITE_CLOUDINARY_UPLOAD_PRESET=cmcart_products
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# Payment Gateway (Razorpay ready)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# App Environment
VITE_APP_NAME=CMCart
VITE_APP_ENV=production
VITE_DEMO_MODE=true

# Live Realtime Backend & WebSocket Server
VITE_BACKEND_URL=https://cmcart-backend.onrender.com
VITE_WS_URL=wss://cmcart-backend.onrender.com

