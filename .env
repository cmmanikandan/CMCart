# CMCart Local Environment
VITE_APP_NAME=CMCart
VITE_APP_ENV=development
VITE_DEMO_MODE=true

# Firebase Authentication (can be overridden with real credentials)
VITE_FIREBASE_API_KEY=mock-firebase-key
VITE_FIREBASE_AUTH_DOMAIN=cmcart-ecommerce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cmcart-ecommerce
VITE_FIREBASE_STORAGE_BUCKET=cmcart-ecommerce.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:demo123456

# Supabase Database
VITE_SUPABASE_URL=https://cmcart-demo.supabase.co
VITE_SUPABASE_ANON_KEY=mock-supabase-key

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=cmcart-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=cmcart_preset

# Razorpay
VITE_RAZORPAY_KEY_ID=rzp_test_demo123456
